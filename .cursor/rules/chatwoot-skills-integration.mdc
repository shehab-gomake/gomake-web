## 🔍 Common Translation Patterns

### Vue Component → React Component

**Chatwoot (Vue):**
```vue
<script setup>
import { ref, computed, onMounted } from 'vue';
import { useStore } from 'vuex';

const store = useStore();
const message = ref('');
const conversations = computed(() => store.getters['conversations/getAll']);

const sendMessage = async () => {
  await store.dispatch('conversations/sendMessage', message.value);
};

onMounted(() => {
  store.dispatch('conversations/fetch');
});
</script>
```

**FrontDesk (React):**
```typescript
import React, { useCallback, useEffect, useMemo, useState } from 'react';
import { useRecoilState, useRecoilValue } from 'recoil';
import { chatwootConversationsAtom } from '@/store/frontdesk/atoms/chatwoot.atoms';
import { useChatwootConversations } from '../hooks/use-chatwoot-conversations';

export const MessageComposer: React.FC = () => {
  const [message, setMessage] = useState('');
  const conversations = useRecoilValue(chatwootConversationsAtom);
  const { sendMessage: send } = useChatwootConversations();

  const handleSend = useCallback(async () => {
    await send(message);
    setMessage('');
  }, [message, send]);

  return (
    <div>
      <input value={message} onChange={e => setMessage(e.target.value)} />
      <button onClick={handleSend}>Send</button>
    </div>
  );
};
```

### Vuex Store → Recoil Atoms + Hooks

**Chatwoot (Vuex Module):**
```javascript
// store/modules/conversations/actions.js
export const actions = {
  async sendMessage({ commit }, { conversationId, message }) {
    // Optimistic update
    const tempId = Date.now();
    commit('ADD_MESSAGE', { id: tempId, content: message, status: 'pending' });
    
    try {
      const response = await MessageApi.create({ conversationId, message });
      commit('UPDATE_MESSAGE', { tempId, message: response.data });
    } catch (error) {
      commit('REMOVE_MESSAGE', tempId);
      throw error;
    }
  }
};
```

**FrontDesk (Hook + Atom):**
```typescript
// hooks/use-chatwoot-messages.ts
import { useCallback } from 'react';
import { useRecoilState } from 'recoil';
import { chatwootMessagesAtom } from '@/store/frontdesk/atoms/chatwoot.atoms';
import { chatwootService } from '@/services/frontdesk';

export const useChatwootMessages = (accountId: number, conversationId: number) => {
  const [messages, setMessages] = useRecoilState(chatwootMessagesAtom);

  const sendMessage = useCallback(async (content: string) => {
    const tempId = `temp-${Date.now()}`;
    
    // Optimistic update
    setMessages(prev => [...prev, {
      id: tempId,
      content,
      status: 'pending',
      conversation_id: conversationId
    }]);

    try {
      const message = await chatwootService.messages.createMessage(
        accountId,
        conversationId,
        { content, message_type: 'outgoing' }
      );
      
      // Replace temp with real message
      setMessages(prev => prev.map(m => 
        m.id === tempId ? message : m
      ));
    } catch (error) {
      // Remove on failure
      setMessages(prev => prev.filter(m => m.id !== tempId));
      throw error;
    }
  }, [accountId, conversationId, setMessages]);

  return { messages, sendMessage };
};
```

### Vue API Client → FrontDesk Service

**Chatwoot (API Client):**
```javascript
// api/inbox/message.js
class MessageApi extends ApiClient {
  create({ conversationId, message, private: isPrivate }) {
    return axios.post(`${this.url}/${conversationId}/messages`, {
      content: message,
      private: isPrivate
    });
  }
}
```

**FrontDesk (Service):**
```typescript
// services/frontdesk/api/chatwoot/services/chatwoot-messages.service.ts
export class ChatwootMessagesService {
  private baseUrl = '/api/v1/accounts';

  async createMessage(
    accountId: number,
    conversationId: number,
    data: CreateMessageDto
  ): Promise<Message> {
    const url = `${this.baseUrl}/${accountId}/conversations/${conversationId}/messages`;
    const response = await httpClient.post<Message>(url, data);
    return response.data;
  }
}
```

## 🎨 Pattern Translation Cheat Sheet

| Chatwoot Pattern | FrontDesk Equivalent |
|-----------------|---------------------|
| `<script setup>` | `React.FC` component |
| `ref()` | `useState()` |
| `computed()` | `useMemo()` |
| `watch()` | `useEffect()` |
| `onMounted()` | `useEffect(() => {}, [])` |
| `onUnmounted()` | `return () => {}` in useEffect |
| Vuex `store.state` | Recoil `atom` |
| Vuex `getters` | Recoil `selector` |
| Vuex `actions` | Custom hooks |
| Vuex `mutations` | `useSetRecoilState()` |
| `store.dispatch()` | Call hook method |
| `store.commit()` | `setAtom()` |
| Vue `props` | React `props` |
| Vue `emit` | Callback props |
| `v-if` | `condition &&` |
| `v-for` | `.map()` |
| `@click` | `onClick` |
| `:class` | `className` or `sx` |

## 📝 Example: Implementing Message Sending

### 1. Read the Skill
```bash
cat .claude/skills/chatwoot/flows/message-sending-flow.md
```

### 2. Study Chatwoot Files
From skill, identify key files:
- `app/javascript/dashboard/components/widgets/conversation/ReplyBox.vue`
- `app/javascript/dashboard/store/modules/conversations/actions.js`
- `app/javascript/dashboard/api/inbox/message.js`

### 3. Create Adaptation Plan
| Chatwoot | FrontDesk |
|----------|-----------|
| `ReplyBox.vue` | `MessageComposer.tsx` |
| `sendMessageAsReply` action | `useChatwootMessages().sendMessage` |
| `MessageApi.create()` | `chatwootService.messages.createMessage()` |
| `ADD_MESSAGE` mutation | `setMessages(prev => [...prev, message])` |

### 4. Implement Following FrontDesk Patterns
```typescript
// components/messages/message-composer.tsx
export const MessageComposer: React.FC<{ conversationId: number }> = ({ conversationId }) => {
  const accountId = useRecoilValue(chatwootSelectedAccountAtom);
  const { sendMessage } = useChatwootMessages(accountId!, conversationId);
  const [content, setContent] = useState('');

  const handleSend = useCallback(async () => {
    if (!content.trim()) return;
    await sendMessage(content);
    setContent('');
  }, [content, sendMessage]);

  return (
    <Box>
      <TextField
        value={content}
        onChange={e => setContent(e.target.value)}
        placeholder="Type a message..."
      />
      <Button onClick={handleSend}>Send</Button>
    </Box>
  );
};
```

## 🚫 Common Mistakes

### ❌ WRONG: Direct Copy-Paste
```typescript
// Don't copy Vue code directly
import { ref } from 'vue'; // ❌ Wrong framework
const message = ref('');
```

### ✅ CORRECT: Adapt to React
```typescript
import { useState } from 'react';
const [message, setMessage] = useState('');
```

### ❌ WRONG: Ignoring Account Scoping
```typescript
// Chatwoot extracts accountId from URL
const accountId = window.location.pathname.split('/')[3]; // ❌ Don't do this
```

### ✅ CORRECT: Use Recoil Atom
```typescript
const accountId = useRecoilValue(chatwootSelectedAccountAtom);
```

